{
  "name": "candamil-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para candamilabogados.com (Express + PostgreSQL + OpenAI)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.js",
    "db:estado": "node --env-file-if-exists=.env scripts/migrar.js --estado",
    "usuario:crear": "node --env-file-if-exists=.env scripts/crear-usuario.js",
    "usuario:clave": "node --env-file-if-exists=.env scripts/cambiar-clave.js",
    "probar": "node .pruebas/panel.test.mjs && node .pruebas/bloques.test.mjs && node .pruebas/imagenes.test.mjs && node .pruebas/colores.test.mjs && node .pruebas/fondos.test.mjs && node .pruebas/editor.test.mjs && node .pruebas/publicar.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
