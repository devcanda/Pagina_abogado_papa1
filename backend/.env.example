# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Prefijo de montaje de la API.
#   "/api" → subdominio dedicado (api.candamilabogados.com/api/paginas)
#   ""     → cPanel ya monta la app en /api (evita /api/api)
API_BASE_PATH=/api

# Orígenes permitidos por CORS, separados por coma.
# En producción: https://candamilabogados.com,https://www.candamilabogados.com
# Los DOS puertos del frontend: 4321 es `npm run dev` y 4340 es
# `npm run preview`, que sirve el sitio ya compilado. Las herramientas y las
# pruebas usan el segundo.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:4340,http://127.0.0.1:4340

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# En cPanel el usuario y la base llevan el prefijo de la cuenta: cpuser_candamil
DATABASE_URL=postgresql://candamil_app:cambia_esta_clave@localhost:5432/candamil_db
# Ponlo en "true" solo si tu proveedor exige SSL (cPanel local normalmente no).
DATABASE_SSL=false

# ─── Panel de contenido ──────────────────────────────────────────────────────
# Carpeta donde el panel escribe las imágenes. Tiene que ser la que sirve
# Apache: en local, la de Astro; en cPanel, public_html/img.
CARPETA_MEDIOS=../frontend/public/img
URL_PANEL=http://localhost:3000/panel

# ─── OpenAI (Bot de Triage Legal) ────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─── Publicación (recompilar el sitio) ──────────────────────────────────────
# Dónde está el proyecto de Astro, visto desde backend/. En cPanel apunta a
# donde esté el proyecto, que no suele colgar de public_html.
CARPETA_FRONTEND=../frontend

# El TALLER donde se compila antes de dar el cambiazo. Dos condiciones, y las
# dos salieron de verlo fallar:
#   · FUERA del proyecto de Astro. Dentro, el vigilante de Vite abre
#     manejadores sobre lo que se escribe y el renombrado final da EPERM en
#     Windows: con el servidor de desarrollo levantado, publicar no funcionaba.
#   · En el MISMO volumen que dist/, o el renombrado da EXDEV. Por eso no vale
#     /tmp ni otra unidad.
CARPETA_PUBLICACION=../.publicacion

# Solo si en el servidor hace falta otra orden (ruta absoluta de node, pnpm…).
# `--outDir` lo añade el servicio por su cuenta; no hay que ponerlo aquí.
# ORDEN_COMPILACION=npx
# ARGUMENTOS_COMPILACION=astro build

# URL que usa la compilación para traerse el contenido. Si se omite, se arma
# sola con PORT y API_BASE_PATH.
# URL_API_COMPILACION=http://localhost:3000/api
