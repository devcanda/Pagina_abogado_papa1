---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Página no encontrada | Candamil Abogados" noIndex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-marino-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-marino-900">No encontramos esta página</h1>
    <p class="mt-3 text-tinta-suave">
      Es posible que el enlace haya cambiado. Escríbenos y te orientamos.
    </p>
    <a href="/" class="btn-secundario mt-8">Volver al inicio</a>
  </div>
</Layout>
