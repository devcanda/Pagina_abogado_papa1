---
/**
 * Cabecera corporativa. No se renderiza nunca en una landing page.
 *
 * Va en navy porque el logotipo horizontal del cliente tiene el texto en
 * blanco. De paso resuelve el problema que tenía la versión anterior: con el
 * logotipo vertical la barra necesitaba ~104px de alto para que el texto se
 * leyera; con el horizontal baja a ~68px.
 */
import BarraContacto from '../../components/BarraContacto.astro';
import Logo from '../../components/Logo.astro';
import { telefonoMarcable, redesEnUso } from '../../data/contacto.js';
import { ICONOS_REDES } from '../../data/iconos-redes.js';
import IconoRed from '../../components/IconoRed.astro';

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/quienes-somos/', texto: 'Quiénes somos' },
  { href: '/areas/', texto: 'Áreas de práctica' },
  /*
   * «Blog jurídico» queda APARCADO (18-11-2026, petición del cliente): la
   * sección aún no se va a manejar.
   *
   * No es solo que no haya contenido: `/blog/` **no existe**, así que el
   * enlace daba un 404 en la cabecera de todas las páginas. Un menú que
   * lleva a una página de error cuesta más que un menú con una opción menos,
   * y a Google le dice que el sitio está roto.
   *
   * Se deja comentado y no borrado: el día que haya blog es descomentar esta
   * línea. El pie lo sigue enlazando; ver `Footer.astro`.
   */
  // { href: '/blog/', texto: 'Blog jurídico' },
  { href: '/contacto/', texto: 'Contacto' },
];

const rutaActual = Astro.url.pathname;

/*
 * La portada se compara EXACTA; las demás, por prefijo.
 *
 * El marcado de «la que estoy viendo» era `rutaActual.startsWith(href)`, y con
 * «Inicio» en la lista eso se rompe solo: toda ruta empieza por `/`, así que
 * la portada quedaría marcada como activa en TODAS las páginas y habría dos
 * enlaces subrayados a la vez. El prefijo sigue haciendo falta en las demás,
 * porque una subpágina (`/areas/laboral/`) debe marcar a su sección.
 */
const esActual = (href) =>
  href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
/*
 * El teléfono sale de `contacto.js`, no del `.env`.
 *
 * Este componente lo leía por su cuenta: un NAP duplicado, que es el agujero
 * que el proyecto ya cerró una vez con el resto de los datos de contacto. El
 * mismo fallo estaba en `TextoConImagen.astro` y se corrigió ayer.
 */

/*
 * Las redes del menú MÓVIL. La barra superior va oculta por debajo de `md`,
 * así que sin esto el teléfono se queda sin un solo acceso a las redes. Se
 * descarta en silencio la que no tenga glifo, igual que en la barra.
 */
const redes = redesEnUso()
  .filter((red) => ICONOS_REDES[red.nombre])
  .map((red) => ({ ...red, ...ICONOS_REDES[red.nombre] }));
---

<BarraContacto />

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-marino-800 shadow-md"
  data-superficie="oscura"
>
  <nav
    class="contenedor flex items-center justify-between gap-4 py-2.5"
    aria-label="Navegación principal"
  >
    <a href="/" aria-label="Candamil Asociados Abogados — ir al inicio" class="shrink-0">
      <Logo />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {enlaces.map((enlace) => (
        <li>
          <a
            href={enlace.href}
            class="relative py-2 text-sm font-semibold text-marino-100 transition-colors
                   hover:text-white
                   aria-[current=page]:text-white
                   after:absolute after:inset-x-0 after:-bottom-px after:h-0.5
                   after:origin-left after:scale-x-0 after:bg-rojo-500 after:transition-transform
                   hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
            aria-current={esActual(enlace.href) ? 'page' : undefined}
          >
            {enlace.texto}
          </a>
        </li>
      ))}
    </ul>

    <a href={`tel:${telefonoMarcable}`} class="btn-primario-oscuro hidden px-5 py-2.5 text-sm lg:inline-flex">
      Agendar consulta
    </a>

    <!-- En móvil el menú se abre con el <details>: sin JS y sin bloquear el hilo. -->
    <details class="relative lg:hidden">
      <summary
        class="flex size-11 cursor-pointer items-center justify-center rounded-lg
               border border-white/25 marker:content-none
               [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <svg class="size-6 text-white" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>

      <ul
        class="absolute right-0 top-full mt-2 w-60 rounded-xl border border-humo-200
               bg-white py-2 shadow-xl"
      >
        {enlaces.map((enlace) => (
          <li>
            {/*
                El móvil también marca la página actual. No lo hacía, y con
                «Inicio» en la lista se nota más: un menú de cinco entradas sin
                señal de dónde está uno obliga a recordarlo.
            */}
            <a
              href={enlace.href}
              class="block px-4 py-3 text-sm font-semibold text-tinta aria-[current=page]:text-marino-600"
              aria-current={esActual(enlace.href) ? 'page' : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))}
        <li class="mt-1 border-t border-humo-200 px-4 pt-3">
          <a href={`tel:${telefonoMarcable}`} class="btn-primario w-full py-2.5 text-sm">
            Agendar consulta
          </a>
        </li>

        {redes.length > 0 && (
          <li class="mt-3 border-t border-humo-200 px-4 pt-3">
            {/*
                Los iconos miden 44px de lado: aquí sí es un objetivo de dedo,
                y 44 es el mínimo que fija el proyecto. El `-ml-2.5` devuelve
                el relleno del primero para que su dibujo quede a ras del
                texto de los enlaces de arriba.
            */}
            <ul class="-ml-2.5 flex items-center gap-1">
              {redes.map((red) => (
                <li>
                  <IconoRed
                    red={red}
                    clase="flex size-11 items-center justify-center rounded-lg text-marino-600"
                    claseIcono="size-5"
                  />
                </li>
              ))}
            </ul>
          </li>
        )}
      </ul>
    </details>
  </nav>
</header>
