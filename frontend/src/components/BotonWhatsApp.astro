---
/**
 * Botón flotante de WhatsApp.
 *
 * Se muestra SOLO donde el Sticky CTA no está: en escritorio de las páginas
 * corporativas. En móvil la barra inferior ya tiene WhatsApp como acción
 * principal, y superponer una burbuja encima la taparía y duplicaría la misma
 * acción a dos centímetros de distancia.
 *
 * Relleno `#25D366`: el verde oficial de WhatsApp, por decisión del cliente.
 *
 * Tiene un coste medido: el glifo blanco encima queda en 1.98:1, por debajo
 * del 3:1 que WCAG 1.4.11 pide a los objetos gráficos. Se asume porque la
 * silueta de WhatsApp es universalmente reconocible y el significado del
 * botón no depende de leer el glifo: lo lleva el `aria-label`.
 *
 * Lo que sí se recupera es el BORDE. `#25D366` sobre blanco da 1.76:1 y sobre
 * el fondo humo 1.85:1, así que el botón se difuminaba contra la página. El
 * aro `#128C7E` —también verde oficial— lo delimita y es el único tono que
 * supera 3:1 sobre los tres fondos del sitio: 4.14:1 sobre blanco, 3.86:1
 * sobre humo y 3.77:1 sobre navy.
 */
const { mensaje } = Astro.props;

import { whatsapp, enlaceWhatsApp } from '../data/contacto.js';

const enlace = enlaceWhatsApp(mensaje);
---

{whatsapp && (
  <a
    href={enlace}
    target="_blank"
    rel="noopener noreferrer nofollow"
    data-cta="whatsapp-flotante"
    aria-label="Escribir por WhatsApp (se abre en otra pestaña)"
    class="group fixed bottom-6 right-6 z-50 hidden size-14 items-center justify-center
           rounded-full bg-[#25D366] text-white ring-2 ring-[#128C7E]
           shadow-lg shadow-black/25
           transition-transform hover:scale-105 focus-visible:outline-2
           focus-visible:outline-offset-2 focus-visible:outline-marino-600
           md:flex"
    style="margin-bottom: env(safe-area-inset-bottom);"
  >
    <!--
      Marca oficial de WhatsApp. Se usa el trazado auténtico, no una
      aproximación: el reconocimiento de este icono es justo lo que hace que la
      gente lo pulse, y un dibujo parecido lo pierde.
    -->
    <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488" />
    </svg>

    <!-- Etiqueta que aparece al acercar el cursor: aclara qué hace el botón
         sin ocupar sitio mientras no haga falta. -->
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-lg
             bg-marino-900 px-3 py-2 text-sm font-semibold text-white opacity-0
             shadow-lg transition-opacity group-hover:opacity-100
             group-focus-visible:opacity-100"
      aria-hidden="true"
    >
      Escríbanos por WhatsApp
    </span>
  </a>
)}
