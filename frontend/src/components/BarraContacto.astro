---
/**
 * Franja superior con datos de contacto y redes. En móvil se oculta: ocuparía
 * un tercio de la pantalla visible sin aportar a la conversión, y el teléfono
 * ya está en el Sticky CTA. Los iconos de redes sí llegan al teléfono, pero
 * por el menú de la cabecera, no por aquí.
 *
 * ── Revisión del 18-11-2026 ────────────────────────────────────────────────
 * Las redes pasan a ser Facebook, YouTube y TikTok (petición del cliente), y
 * dejan de estar DECLARADAS AQUÍ.
 *
 * Este componente tenía su propia lista —Facebook, LinkedIn e Instagram, las
 * tres apuntando a `#`—, que es exactamente el agujero que `contacto.js` se
 * creó para cerrar: dos listas de redes acaban discrepando igual que discrepa
 * un NAP repetido. La documentación del proyecto ya daba por hecho que la
 * barra leía `contacto.js`; no era verdad hasta ahora.
 *
 * Los tres `href="#"` eran además enlaces que no llevaban a ninguna parte,
 * anunciados por el lector de pantalla como si llevaran.
 *
 * Hoy los tres logotipos SE VEN pero no enlazan a nada: el cliente todavía no
 * tiene las direcciones de los perfiles y prefirió el dibujo puesto. El
 * reparto entre «enlace» y «solo dibujo» lo hace `IconoRed.astro`; el día que
 * pegue las URLs en `contacto.js`, se convierten en enlaces solas.
 */
import { telefono, telefonoMarcable, email, direccion, mapa, redesEnUso } from '../data/contacto.js';
import { ICONOS_REDES } from '../data/iconos-redes.js';
import IconoRed from './IconoRed.astro';

/*
 * Se descarta en silencio una red sin glifo. Es el caso de una clave nueva en
 * `contacto.js` para la que nadie añadió el dibujo: mejor que no salga a que
 * salga un hueco en blanco que nadie sabe pulsar.
 */
const redes = redesEnUso()
  .filter((red) => ICONOS_REDES[red.nombre])
  .map((red) => ({ ...red, ...ICONOS_REDES[red.nombre] }));
---

<div class="hidden bg-marino-900 text-marino-100 md:block" data-superficie="oscura">
  <div class="contenedor flex items-center justify-between gap-6 py-2 text-xs">
    <ul class="flex items-center gap-6">
      <li>
        <a
          href={`tel:${telefonoMarcable}`}
          class="flex items-center gap-2 underline-offset-2 hover:text-white hover:underline"
          aria-label={`Llamar al ${telefono}`}
        >
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />
          </svg>
          {telefono}
        </a>
      </li>
      <li>
        <a href={`mailto:${email}`} class="flex items-center gap-2 hover:text-white">
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5z" />
          </svg>
          {email}
        </a>
      </li>
      <li class="hidden lg:block">
        <a
          href={mapa}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 underline-offset-2 hover:text-white hover:underline"
          aria-label={`Ver la oficina en Google Maps: ${direccion} (se abre en otra pestaña)`}
        >
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5" />
          </svg>
          {direccion}
          <!-- Marca de enlace externo: avisa de que sale del sitio. -->
          <svg class="size-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 4h6v6M20 4l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
          </svg>
        </a>
      </li>
    </ul>

    {redes.length > 0 && (
      <!--
          El relleno del enlace no es estético: WCAG 2.5.8 pide 24×24 CSS
          como objetivo mínimo, y un icono de 16px suelto se queda corto. Con
          `p-1.5` la zona pulsable mide 28px. El `-mr-1.5` devuelve el relleno
          del último para que el borde derecho siga a ras del contenedor.
      -->
      <ul class="-mr-1.5 flex items-center gap-1">
        {redes.map((red) => (
          <li>
            <IconoRed
              red={red}
              clase="block rounded p-1.5 text-marino-100/70 transition-colors"
              claseHover="hover:text-white"
              claseIcono="size-4"
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
