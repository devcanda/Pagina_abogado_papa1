---
/**
 * Franja superior con datos de contacto y redes. En móvil se oculta: ocuparía
 * un tercio de la pantalla visible sin aportar a la conversión, y el teléfono
 * ya está en el Sticky CTA.
 */
import { telefono, telefonoMarcable, email, direccion, mapa } from '../data/contacto.js';

const redes = [
  { nombre: 'Facebook', href: '#', d: 'M13 10h3l.5-4H13V4c0-1.1.2-1.7 1.8-1.7H16.5V-1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5V6H6v4h3.5v10H13z' },
  { nombre: 'LinkedIn', href: '#', d: 'M4.5 3.5a2 2 0 1 1-.1 4 2 2 0 0 1 .1-4M3 9h3v12H3zm5.5 0h2.9v1.6h.1a3.2 3.2 0 0 1 2.9-1.6c3 0 3.6 2 3.6 4.6V21h-3v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21h-3z' },
  { nombre: 'Instagram', href: '#', d: 'M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2m0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6m5.8-7.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0M12 2.2c-2.7 0-3 0-4.1.1-2.6.1-4.2 1.7-4.3 4.3-.1 1.1-.1 1.4-.1 4.1s0 3 .1 4.1c.1 2.6 1.7 4.2 4.3 4.3 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c2.6-.1 4.2-1.7 4.3-4.3.1-1.1.1-1.4.1-4.1s0-3-.1-4.1c-.1-2.6-1.7-4.2-4.3-4.3-1.1-.1-1.4-.1-4.1-.1' },
];
---

<div class="hidden bg-marino-900 text-marino-100 md:block" data-superficie="oscura">
  <div class="contenedor flex items-center justify-between gap-6 py-2 text-xs">
    <ul class="flex items-center gap-6">
      <li>
        <a
          href={`tel:${telefonoMarcable}`}
          class="flex items-center gap-2 underline-offset-2 hover:text-white hover:underline"
          aria-label={`Llamar al ${telefono}`}
        >
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />
          </svg>
          {telefono}
        </a>
      </li>
      <li>
        <a href={`mailto:${email}`} class="flex items-center gap-2 hover:text-white">
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5z" />
          </svg>
          {email}
        </a>
      </li>
      <li class="hidden lg:block">
        <a
          href={mapa}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 underline-offset-2 hover:text-white hover:underline"
          aria-label={`Ver la oficina en Google Maps: ${direccion} (se abre en otra pestaña)`}
        >
          <svg class="size-3.5 text-rojo-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5" />
          </svg>
          {direccion}
          <!-- Marca de enlace externo: avisa de que sale del sitio. -->
          <svg class="size-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 4h6v6M20 4l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
          </svg>
        </a>
      </li>
    </ul>

    <ul class="flex items-center gap-4">
      {redes.map((red) => (
        <li>
          <a
            href={red.href}
            aria-label={red.nombre}
            rel="noopener noreferrer nofollow"
            class="block text-marino-100/70 hover:text-white"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={red.d} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
