---
/**
 * Tarjeta moderna de Área de Práctica — inspirada en el patrón "Modern 3 Columns"
 * de LawyerBase y adaptada estrictamente al sistema de diseño de Candamil Abogados.
 *
 * Características:
 * - Proporción apaisada 7:4 / 16:10 con imagen optimizada de fondo.
 * - Velo de color Navy (marino-900) con degradado para garantizar contraste >7:1.
 * - Al hacer hover: micro-zoom suave de la imagen y reducción del velo para apreciar la foto.
 * - Título centrado en Playfair Display con filete decorativo azul.
 * - Sin JavaScript: 100% CSS nativo y utilidades de Tailwind CSS 4.
 */
interface Props {
  area: {
    id: string;
    nombre: string;
    subtitulo: string;
    imagen: string;
    href: string;
    ctaTexto?: string;
    destacado?: boolean;
  };
}

const { area } = Astro.props;
---

<li class="h-full list-none">
  <a
    href={area.href}
    class="group relative flex aspect-7/4 w-full flex-col items-center justify-center
           overflow-hidden rounded-xl border border-marino-900/10 bg-marino-900
           p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl
           focus:outline-none focus-visible:ring-3 focus-visible:ring-marino-400
           focus-visible:ring-offset-2 focus-visible:ring-offset-white"
    aria-label={`${area.nombre}: ${area.subtitulo}`}
  >
    <!-- Imagen de fondo con zoom suave en hover -->
    <img
      src={area.imagen}
      alt=""
      width="700"
      height="400"
      class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out
             group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />

    <!-- Velo de marca Navy que se atenúa suavemente al pasar el cursor -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-marino-950/90 via-marino-900/80 to-marino-900/65
             transition-opacity duration-300 group-hover:opacity-40"
      aria-hidden="true"
    />

    <!-- Capa de contenido central (patrón LawyerBase Modern) -->
    <div class="relative z-10 flex flex-col items-center justify-center text-center px-2">
      <h3
        class="font-display text-xl font-bold tracking-wide text-white drop-shadow-md
               sm:text-2xl lg:text-xl xl:text-2xl"
      >
        {area.nombre}
      </h3>

      <!-- Filete sutil de marca (azul) que se ensancha al interactuar -->
      <span
        class="mt-2.5 h-0.5 w-8 rounded-full bg-marino-300/80 transition-all duration-300
               group-hover:w-16 group-hover:bg-white"
        aria-hidden="true"
      />

      <!-- Subtítulo breve que se enfatiza en pantallas grandes -->
      <p
        class="mt-3 line-clamp-2 max-w-xs text-xs font-medium leading-relaxed text-marino-100/90
               drop-shadow transition-colors group-hover:text-white sm:text-sm"
      >
        {area.subtitulo}
      </p>

      <!-- Indicador accesible de acción -->
      <span
        class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider
               text-white/80 opacity-0 transition-all duration-300 group-hover:opacity-100
               group-hover:translate-y-0 translate-y-1"
        aria-hidden="true"
      >
        <span>{area.ctaTexto ?? 'Consultar área'}</span>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </span>
    </div>
  </a>
</li>
