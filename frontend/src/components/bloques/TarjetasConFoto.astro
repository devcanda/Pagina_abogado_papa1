---
/** BLOQUE «tarjetasConFoto» — casos, noticias o proyectos con fotografía. */
const { datos = {} } = Astro.props;
const {
  etiqueta = '', titulo = '', destacado = '', texto = '',
  textoBoton = '', enlaceBoton = '/casos/', tarjetas = [],
  colorTitulo = '',
  colorTexto = '',
} = datos;

/*
 * Colores del texto, elegidos desde el panel. Van en línea porque tienen que
 * ganar a la clase de utilidad; si no se han tocado llegan vacíos y no se
 * emite ningún `style`, así que el bloque se ve exactamente como antes.
 *
 * El panel enseña el contraste medido al elegirlos, pero NO lo impone: es
 * decisión del cliente (D4 de la spec 002). Un color ilegible aquí es un color
 * ilegible en la página.
 */
const estiloTitulo = colorTitulo ? { color: colorTitulo } : undefined;
const estiloTexto = colorTexto ? { color: colorTexto } : undefined;
---

<section class="contenedor py-20 lg:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="etiqueta-seccion">{etiqueta}</p>
    <h2 class="titular mt-3" style={estiloTitulo}>
      {titulo} {destacado && <span class="destacado">{destacado}</span>}
    </h2>
    <p class="mt-5 text-tinta-suave">{texto}</p>
  </div>

  <ul class="mt-14 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
    {tarjetas.map((caso) => (
      <li class="group border border-humo-200 bg-white transition-shadow hover:shadow-xl">
        <div class="relative aspect-16/10 overflow-hidden">
          <img
            src={caso.imagen}
            alt=""
            width="600"
            height="375"
            class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <span
            class="absolute left-4 top-4 bg-white px-3 py-1 text-[0.65rem] font-bold
                   uppercase tracking-[0.15em] text-marino-900"
          >
            {caso.etiqueta}
          </span>
        </div>

        <div class="p-6">
          <h3 class="font-display text-xl font-bold leading-snug text-marino-900">
            {caso.titulo}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-tinta-suave">{caso.resumen}</p>
          <p class="mt-5 flex items-center gap-2 border-t border-humo-200 pt-4
                    text-xs font-semibold uppercase tracking-wider text-tinta-suave">
            <svg class="size-4 text-rojo-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m-1.2 14.2-4-4 1.6-1.6 2.4 2.4 5.2-5.2 1.6 1.7z" />
            </svg>
            {caso.pie}
          </p>
        </div>
      </li>
    ))}
  </ul>

  {textoBoton && (
    <div class="mt-12 text-center">
      <a href={enlaceBoton} class="btn-secundario">{textoBoton}</a>
    </div>
  )}
</section>
