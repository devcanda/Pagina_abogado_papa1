     * El retraso de la primera es NEGATIVO (-0,95 s) para que arranque ya
     * opaca. Con retraso cero entraría con un fundido de casi un segundo al
     * cargar la página, y el titular es el elemento que marca el LCP.
     */
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-lamina {
      animation-name: cabecera-pase-3;
      animation-duration: 15s;
      animation-delay: -0.95s;
    }
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-punto::before {
      animation-name: cabecera-punto-3;
      animation-duration: 15s;
      animation-delay: -0.95s;
    }
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-lamina:nth-child(2),
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-punto:nth-of-type(2)::before {
