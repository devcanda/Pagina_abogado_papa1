    }
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-lamina:nth-child(3),
    .cabecera[data-laminas='3']:not(:has(.cabecera-radio:checked)) .cabecera-punto:nth-of-type(3)::before {
      animation-delay: 9.05s;
    }

    /* Dos láminas: mismo paso de 5 s, vuelta de 10 s. */
    .cabecera[data-laminas='2']:not(:has(.cabecera-radio:checked)) .cabecera-lamina {
      animation-name: cabecera-pase-2;
      animation-duration: 10s;
      animation-delay: -0.95s;
    }
    .cabecera[data-laminas='2']:not(:has(.cabecera-radio:checked)) .cabecera-punto::before {
      animation-name: cabecera-punto-2;
      animation-duration: 10s;
      animation-delay: -0.95s;
    }
    .cabecera[data-laminas='2']:not(:has(.cabecera-radio:checked)) .cabecera-lamina:nth-child(2),
    .cabecera[data-laminas='2']:not(:has(.cabecera-radio:checked)) .cabecera-punto:nth-of-type(2)::before {
      animation-delay: 4.05s;
    }

    /*
     * El pase se congela mientras el foco esté dentro.
     *
     * Congela láminas y puntos a la vez, o el punto marcaría una lámina que no
     * es la que se está viendo.
     *
     * Era la segunda mitad del congelado; la primera era el botón de pausa,
     * retirado a petición del cliente. Esta se queda porque no es un control
     * visible: evita que la lámina cambie bajo los pies de quien está tabulando
     * por los botones de la cabecera, que es un problema de uso, no de gusto.
     */
    .cabecera:focus-within .cabecera-lamina,
    .cabecera:focus-within .cabecera-punto::before {
      animation-play-state: paused;
    }

    .cabecera-mandos {
      display: flex;
    }

    /*
     * La capa de fondo cubre también la fila de mandos.
     *
     * Va aquí y no fuera a propósito: sin `:has()` los mandos no se pintan
     * —no hay forma de cambiar de lámina— y entonces no hay franja que
     * cubrir. Estirar la capa ahí la sacaría 4rem por debajo del contenido
     * sin motivo y movería el encuadre de la foto.
     */
    .cabecera-fondo {
      bottom: calc(-1 * var(--cabecera-mandos));
    }

    /* Cada estado destapa su «anterior» y su «siguiente». */
    .cabecera:has(.cabecera-radio:nth-of-type(1):checked) .cabecera-flecha[data-estado='1'],
    .cabecera:has(.cabecera-radio:nth-of-type(2):checked) .cabecera-flecha[data-estado='2'],
    .cabecera:has(.cabecera-radio:nth-of-type(3):checked) .cabecera-flecha[data-estado='3'],
    /*
     * Durante el pase automático se enseña el par de la primera lámina. El CSS
     * no puede saber por cuál va la animación, así que pulsar «siguiente» a
     * mitad del pase lleva a la segunda, venga de donde venga. Detiene el pase
     * y deja al visitante en una lámina concreta, que es lo que buscaba.
     */
    .cabecera:not(:has(.cabecera-radio:checked)) .cabecera-flecha[data-estado='1'] {
      display: grid;
    }

    /*
     * «Menos movimiento»: nada se mueve solo. Es justo el caso que la
     * preferencia existe para cubrir, así que el pase no se ralentiza: se
     * apaga, y queda la primera lámina con sus mandos.
     */
    @media (prefers-reduced-motion: reduce) {
      .cabecera[data-laminas]:not(:has(.cabecera-radio:checked)) .cabecera-lamina,
      .cabecera[data-laminas]:not(:has(.cabecera-radio:checked)) .cabecera-punto::before {
        animation-name: none;
      }
    }
  }

  /* ─── Fotogramas del pase ───────────────────────────────────────────────
   *
   * Los porcentajes salen de los tiempos, no al revés:
   *   entrada 0,95 s · quieta 3,6 s · salida 0,5 s · paso 5 s
   *   3 láminas -> ciclo 15 s:  6,333% / 30,333% / 33,667%
   *   2 láminas -> ciclo 10 s:  9,5%   / 45,5%   / 50,5%
   *
   * `visibility` se declara en DOS fotogramas pegados (33,667% y 33,767%)
   * porque es una propiedad discreta: si solo se pusiera en uno, el navegador
   * la cambiaría a mitad del tramo anterior y la lámina desaparecería de golpe
   * en plena salida.
   */
  @keyframes cabecera-pase-3 {
    0% { opacity: 0; visibility: visible; transform: translateX(1.5rem); }
    6.333% { opacity: 1; visibility: visible; transform: none; }
    30.333% { opacity: 1; visibility: visible; transform: none; }
    33.667% { opacity: 0; visibility: visible; transform: translateX(-1.5rem); }
    33.767% { opacity: 0; visibility: hidden; transform: translateX(1.5rem); }
    100% { opacity: 0; visibility: hidden; transform: translateX(1.5rem); }
  }

  @keyframes cabecera-pase-2 {
    0% { opacity: 0; visibility: visible; transform: translateX(1.5rem); }
    9.5% { opacity: 1; visibility: visible; transform: none; }
    45.5% { opacity: 1; visibility: visible; transform: none; }
    50.5% { opacity: 0; visibility: visible; transform: translateX(-1.5rem); }
    50.6% { opacity: 0; visibility: hidden; transform: translateX(1.5rem); }
    100% { opacity: 0; visibility: hidden; transform: translateX(1.5rem); }
  }

  /*
   * El punto se enciende el tramo entero de SU lámina (un tercio, o la mitad
   * con dos). Así siempre hay exactamente uno encendido: el siguiente empieza
   * su ciclo justo cuando este termina el suyo.
   */
  @keyframes cabecera-punto-3 {
    0% { width: 28px; background: rgb(255 255 255 / 1); }
    33.333% { width: 10px; background: rgb(255 255 255 / 0.45); }
    100% { width: 10px; background: rgb(255 255 255 / 0.45); }
  }

  @keyframes cabecera-punto-2 {
    0% { width: 28px; background: rgb(255 255 255 / 1); }
    50% { width: 10px; background: rgb(255 255 255 / 0.45); }
    100% { width: 10px; background: rgb(255 255 255 / 0.45); }
  }

  /* Fuera de la vista pero enfocable: hace falta para las flechas del teclado. */
  .cabecera-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 44px de objetivo táctil aunque el punto visible mida 10. */
  .cabecera-punto {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }

  .cabecera-punto::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    /*
     * Blanco, no rojo. El rojo de marca significa «acción» y cada vez que
     * decora algo, el botón de conversión deja de ser lo más saliente de la
     * pantalla. Un punto de navegación no es una conversión.
     */
    background: rgb(255 255 255 / 0.55);
    /*
     * Aro y sombra oscuros: el punto tiene que leerse también sobre una foto.
     *
     * Antes bastaba el blanco al 45 % porque debajo siempre había navy. Desde
     * que una lámina puede llevar imagen de fondo, debajo puede haber un papel
     * blanco —pasó con el contrato de la foto del ingenio— y el punto
     * desaparecía. El halo lo lleva el propio punto en vez de oscurecer la
     * franja entera, que volvería a meter una banda de otro color.
     */
    box-shadow:
      0 0 0 1px rgb(10 36 67 / 0.5),
      0 1px 3px rgb(10 36 67 / 0.65);
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .cabecera-radio:checked + .cabecera-punto::before {
    width: 28px;
    background: rgb(255 255 255 / 1);
  }

  .cabecera-punto:hover::before {
    background: rgb(255 255 255 / 0.75);
  }

  /* El anillo lo pinta el punto porque el radio es invisible. */
  .cabecera-radio:focus-visible + .cabecera-punto::before {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  /*
   * Flechas.
   *
   * 44px de objetivo táctil con un círculo visible de 40: el mínimo de la
   * WCAG se cumple con el área, no con lo que se ve.
   *
   * Llevan un disco de navy translúcido DEBAJO. No es decoración: sin él, el
   * contraste dependía de lo que hubiera detrás, y detrás puede haber una foto
   * —con el fondo del ingenio, la flecha derecha caía sobre un papel blanco y
   * se perdía—. Con el disco, el aro y el glifo tienen siempre algo oscuro
   * contra lo que recortarse, sea cual sea la imagen que suba el editor.
   *
   * El disco es navy fijo, no `colorFondo`: lo que tiene que tapar es la
   * imagen, no igualar el color de la franja.
   */
  .cabecera-flecha {
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: rgb(255 255 255 / 0.75);
    background-color: rgb(10 36 67 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cabecera-flecha svg {
    width: 20px;
    height: 20px;
  }

  .cabecera-flecha:hover {
    color: #fff;
    background-color: rgb(10 36 67 / 0.75);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
  }

  /*
   * Sin `:active` la flecha no da ninguna señal al pulsarla, y con un relevo
   * de 1,2 s eso se nota: durante casi un segundo nada parece responder.
   */
  .cabecera-flecha:active {
    transform: scale(0.92);
  }

  /* Las láminas se anulan arriba, dentro del `@supports`, por especificidad. */
  @media (prefers-reduced-motion: reduce) {
    .cabecera-punto::before,
    .cabecera-flecha {
      transition: none;
    }

    .cabecera-flecha:active {
      transform: none;
    }
  }
</style>
