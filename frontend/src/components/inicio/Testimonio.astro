---
/**
 * Testimonio destacado sobre panel oscuro, con una palabra enorme al fondo.
 */
const { testimonio } = Astro.props;
---

<section class="contenedor pb-20 lg:pb-28">
  <figure class="relative overflow-hidden bg-marino-900 px-6 py-14 sm:px-12 lg:px-16 lg:py-20">
    <span
      class="palabra-fondo -bottom-8 right-4 text-[22vw] text-white/[0.05] lg:text-[11rem]"
      aria-hidden="true"
    >
      Confianza
    </span>

    <div class="relative grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16">
      <div class="max-w-2xl">
        <svg class="mb-6 size-12 text-rojo-300/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9.7 5.5C6.3 7 4 10.2 4 14c0 3 1.9 4.9 4.3 4.9 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.9.1-1 .1.3-1.6 1.9-3.5 3.5-4.4zm9.5 0C15.8 7 13.5 10.2 13.5 14c0 3 1.9 4.9 4.3 4.9 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.9.1-1 .1.3-1.6 1.9-3.5 3.5-4.4z" />
        </svg>

        <blockquote class="font-display text-2xl leading-snug text-white sm:text-3xl lg:text-4xl">
          <p>{testimonio.cita}</p>
        </blockquote>

        <figcaption class="mt-8 flex items-center gap-4">
          <span class="h-px w-10 bg-rojo-500" aria-hidden="true"></span>
          <span>
            <span class="block font-bold text-white">{testimonio.autor}</span>
            <span class="block text-sm text-marino-100/70">{testimonio.cargo}</span>
          </span>
        </figcaption>
      </div>

      <div class="flex gap-1 text-rojo-300 lg:pb-2" aria-label="Cinco de cinco">
        {Array.from({ length: 5 }).map(() => (
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="m12 17.3-6.2 3.7 1.6-7L2 9.2l7.1-.6L12 2l2.9 6.6 7.1.6-5.4 4.8 1.6 7z" />
          </svg>
        ))}
      </div>
    </div>
  </figure>
</section>
